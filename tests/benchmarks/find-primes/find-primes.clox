
var n = 10000;

fun is_prime(n) {
    if(n == 0 or n == 1) {
        return false;
    }
    for(var i = 2; i < n; i = i + 1) {
        if(n % i == 0) {
            return false;
        }
    }
    return true;
}

for(var i = 0; i < n; i = i + 1) {
    if(is_prime(i)) {
        // print(i);
    }
}