
use fs;


// Get arguments

platform = null;
release = null;
valid = true;

if(_args == 0u) {
    platform = "linux";
    release = false;
} else {
    if(_1 == "all") {
        sh("./caro build.caro windows");
        sh("./caro build.caro macos");
        sh("./caro build.caro linux");
        sh("./caro build.caro freebsd");
        sh("./caro build.caro haiku");
        sh("./caro build.caro web");
    } else if(_1 == "windows" | _1 == "macos" | _1 == "linux" | _1 == "freebsd" | _1 == "haiku" | _1 == "web") {
        platform = _1;
        release = true;
    } else {
        print("Invalid platform " + _1 + ".");
        valid = false;
    }
}


if(valid) {


    // Command parts

    common       = "src/main.cpp -std=c++23 ";

    windows_only = "-target x86_64-windows-gnu ";
    mac_only     = "-target aarch64-macos -Wno-nullability-completeness ";
    linux_only   = "-target x86_64-linux-gnu.2.28 -idirafter /usr/include -L/usr/lib -lreadline ";
    freebsd_only = "-target x86_64-freebsd -Wno-nullability-completeness ";
    web_only     = "-sALLOW_MEMORY_GROWTH -sSTACK_SIZE=8388608 -sEXIT_RUNTIME ";
                                       // = 8mb, because linux threads get 8mb
    
    clang_only   = "-Wno-c99-designator ";
    release_only = "-O2 -g0 -s ";
    

    // Make command

    output = "caro";
    message = "Built for";

    command = "";

    // For Windows and Linux, we compile with Zig, which in turn runs Clang, because it allows us to specify a glibc version.
    // Clang support for C++26 is still rather incomplete, so this uses C++23.

    if(platform == "windows") {
        command = "zig c++ " + common + clang_only + windows_only;
        output = output + "-windows.exe";
        message = message + " Windows";

    } else if(platform == "macos") {
        command = "zig c++ " + common + clang_only + mac_only;
        output = output + "-macos";
        message = message + " macOS";

    } else if(platform == "linux") {
        command = "zig c++ " + common + clang_only + linux_only;
        if(release) {
            output = output + "-linux";
        }
        message = message + " Linux";

    } else if(platform == "freebsd") {
        command = "zig c++ " + common + clang_only + freebsd_only;
        output = output + "-freebsd";
        message = message + " FreeBSD";

    } else if(platform == "haiku") {
        command = "~/haiku-cross/haiku/generated/cross-tools-x86_64/bin/x86_64-unknown-haiku-g++ " + common;
        output = output + "-haiku";
        message = message + " Haiku";

    } else if(platform == "web") {
        if(!fs.exists("builds/web")) {
            fs.create_folder("builds/web");
        }
        command = "/usr/lib/emscripten/em++ " + common + clang_only + web_only;
        release_only = "-O2 -g0 ";
        output = "web/" + output + ".html";
        message = message + " web";

    }

    if(release) {
        command = command + release_only;
        message = message + " release!";
        output = "builds/" + output;
    } else {
        message = message + " debug!";
    }

    command = command + "-o " + output;


    // Build

    sh(command);
    print(message);


}

