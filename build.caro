
use caro;
use fs;


// Command parts

#common       = "src/main.cpp -std=c++23 ";

#platforms = {
    "windows": ["Windows",
        "zig c++ ",
        "-Wno-c99-designator -target x86_64-windows-gnu -lwinhttp -lgdi32 -lcomctl32 -lole32 -ldwmapi -luxtheme -limm32 -DUNICODE -D_UNICODE "
    ],
    "macos":   ["macOS",
        "zig c++ ",
        "-Wno-c99-designator -target aarch64-macos -Wno-nullability-completeness "
    ],
    "linux":   ["Linux",
        "zig c++ ",
        "-Wno-c99-designator -target x86_64-linux-gnu.2.28 -idirafter /usr/include -L/usr/lib -L/usr/lib/x86_64-linux-gnu -ldl "
    ],
    "freebsd": ["FreeBSD",
        "zig c++ ",
        "-Wno-c99-designator -target x86_64-freebsd -Wno-nullability-completeness "
    ],
    "haiku":   ["Haiku",
        caro.platform == "haiku"? "g++ ": "~/haiku-cross/haiku/generated/cross-tools-x86_64/bin/x86_64-unknown-haiku-g++ ",
        "-lbe "
    ],
    "web":     ["web",
        "/usr/lib/emscripten/em++ ",
        "-Wno-c99-designator -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=8388608 -sEXIT_RUNTIME -sASYNCIFY '-sDEFAULT_LIBRARY_FUNCS_TO_INCLUDE=$stringToNewUTF8' "
    ]
};                                                                             // = 8mb, because linux threads get 8mb

release_only = "-O2 -g0 -s ";

#raylib = {
    "windows": ["zig cc -target x86_64-windows-gnu ",
        "-DPLATFORM_DESKTOP_GLFW -DGRAPHICS_API_OPENGL_33 -Iinclude/raylib/external/glfw/include ",
        "-lopengl32 -lgdi32 -lwinmm -lshell32 "
    ],
    "linux":   ["zig cc -target x86_64-linux-gnu.2.28 ",
        "-DPLATFORM_DESKTOP_GLFW -DGRAPHICS_API_OPENGL_33 -D_GLFW_X11 -DSUPPORT_CLIPBOARD_IMAGE=0 -Iinclude/raylib/external/glfw/include -idirafter /usr/include ",
        "-lm -lpthread "
    ],
    "web":     ["/usr/lib/emscripten/emcc ",
        "-DPLATFORM_WEB -DGRAPHICS_API_OPENGL_ES2 ",
        "-sUSE_GLFW=3 "
    ]
};

#raylib_renames = "-DCloseWindow=rlCloseWindow -DShowCursor=rlShowCursor -DLoadImage=rlLoadImage -DDrawText=rlDrawText -DDrawTextEx=rlDrawTextEx -DPlaySound=rlPlaySound";


// For Windows and Linux, we compile with Zig, which in turn runs Clang, because it allows us to specify a glibc version.
// Clang support for C++26 is still rather incomplete, so this uses C++23.


// Get arguments

platform = null;
release = null;
valid = true;

if(_args.length() == 0) {
    platform = caro.platform;
    release = false;
} else {
    if(_args[0] == "all") {
        sh("./caro build.caro windows");
        sh("./caro build.caro macos");
        sh("./caro build.caro linux");
        sh("./caro build.caro freebsd");
        sh("./caro build.caro haiku");
        sh("./caro build.caro web");
        exit();
    } else if(_args[0] == "windows" | _args[0] == "macos" | _args[0] == "linux" | _args[0] == "freebsd" | _args[0] == "haiku" | _args[0] == "web") {
        platform = _args[0];
        release = true;
    } else {
        print("Invalid platform " + _args[0] + ".");
        valid = false;
    }
}


if(valid) {


    // Make command

    command = #platforms[platform][1] + #common + #platforms[platform][2];
    output = "caro";
    message = "Built for " + #platforms[platform][0];

    if(release) {

        output += "-" + platform;
        if(platform == "windows") {
            output += ".exe";
        } elif(platform == "web") {
            release_only = "-O2 -g0 ";
            output = "web/" + output + ".html";
            if(!fs.exists("builds/web")) {
                fs.create_folder("builds/web");
            }
        }
        output = "builds/" + output;

        command = command + release_only;
        message += " release!";
        
    } else {

        message += " debug!";

    }

    command += "-o " + output;


    // Raylib objects
    
    if(platform == "windows" | platform == "linux" | platform == "web") {
        objects = "builds/obj/raylib-" + platform;
        if(!fs.exists(objects + "/rcore.o")) {
            print("Building raylib for " + #platforms[platform][0] + "...");
            sh(
                "mkdir -p " + objects + " && for f in rcore rshapes rtextures rtext rmodels raudio" + (platform == "web"? "": " rglfw") + "; do "
              + "r='" + #raylib_renames + "'; [ $f = rglfw ] && r=''; "
              + #raylib[platform][0] + "-c -O2 -std=gnu99 " + #raylib[platform][1] + "$r -Iinclude/raylib include/raylib/$f.c -o " + objects + "/$f.o || { rm -f " + objects + "/rcore.o; exit 1; }; "
              + "done"
            );
        }
        command += " -DCARO_RAYLIB " + objects + "/*.o " + #raylib[platform][2];
    }


    // Embed files

    if(!fs.exists("LICENSE.md")) {
        print("Couldn't find LICENSE.md.");
        exit(true);
    }
    if(!fs.exists("include/credits.md")) {
        print("Couldn't find include/credits.md.");
        exit(true);
    }
    sh(
        "( printf '// Generated from LICENSE.md and include/credits.md by build.caro.\n\n#pragma once\n\nconstexpr const char* LICENSES = R\042LICENSES(\n' ; cat LICENSE.md ; cat include/credits.md ; printf ')LICENSES\042;\n' )"
      + " > src/core/licenses.hpp"
    );

    if(platform == "web") {
        if(!fs.exists("src/stdlib/util/gui_styles.css")) {
            print("Couldn't find src/stdlib/util/gui_styles.css.");
            exit(true);
        }
        sh(
            "( printf '// Generated from src/stdlib/util/gui_styles.css by build.caro.\n\n#pragma once\n\nconstexpr const char* GUI_STYLES = R\042GUI_STYLES(\n' ; cat src/stdlib/util/gui_styles.css ; printf ')GUI_STYLES\042;\n' )"
          + " > src/stdlib/util/gui_styles.hpp"
        );
    }
    

    // Build

    sh(command);
    print(message);


}

