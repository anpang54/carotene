

// Get arguments

platform = null;
release = null;
valid = true;

if(_args == 0u) {
    platform = "linux";
    release = false;
} else {
    if(_1 == "windows" | _1 == "linux" | _1 == "web") {
        platform = _1;
        release = true;
    } else {
        print("Invalid platform " + _1 + ".");
        valid = false;
    }
}


if(valid) {


    // Make command

    common       = "src/main.cpp -std=c++23 -Wno-c99-designator ";
    windows_only = "-target x86_64-windows-gnu ";
    linux_only   = "-target x86_64-linux-gnu.2.28 -idirafter /usr/include -L/usr/lib -lreadline ";
    web_only     = "-sALLOW_MEMORY_GROWTH -sSTACK_SIZE=8388608 -sEXIT_RUNTIME ";
                                       // = 8mb, because linux threads get 8mb
    release_only = "-O2 -g0 -s ";
    
    // We compile with Zig, which in turn runs Clang, because it allows us to specify a glibc version.
    // Clang support for C++26 is still rather incomplete, so this uses C++23.

    output = "caro";
    message = "Built for";

    if(release) {
        output = output + "-release";
    }

    command = "";
    if(platform == "windows") {
        command = "zig c++ " + common + windows_only;
        output = output + ".exe";
        message = message + " Windows";
    } else if(platform == "web") {
        command = "/usr/lib/emscripten/em++ " + common + web_only;
        release_only = "-O2 -g0 ";
        output = "web/" + output + ".html";
        message = message + " web";
    } else {
        command = "zig c++ " + common + linux_only;
        message = message + " Linux";
    }

    if(release) {
        command = command + release_only;
        message = message + " release!";
        output = "builds/" + output;
    } else {
        message = message + " debug!";
    }

    command = command + "-o " + output;


    // Build

    sh(command);
    print(message);


}

