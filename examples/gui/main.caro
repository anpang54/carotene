
use gui;


// test window

gui.test();


// custom window

window = gui.Window("Woah it's another window", 400, 250, 50);

func print_yes() { print("Yay!"); }
func print_no()  { print("bruh"); }

window.label ( [0, 2],   0   , "Hi again! Notice how this window only opened after you closed that one?");
window.label (   0   ,   1   , "Select:");
window.button(   1   ,   1   , "Yes", print_yes);
window.button(   2   ,   1   , "No",  print_no );

window.show();

