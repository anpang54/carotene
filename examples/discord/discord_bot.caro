
use discord;
use fs;

$bot = discord.Bot();

$bot.on_ready = func() {
    print(f"Logged in as {$bot.username}#{$bot.discriminator}!");
};

$bot.on_message = func(message) {
    switch(message.content) {
        case "!ping":
            $bot.send(message.channel_id, "Pong!");
        case "!reply":
            message.reply("Replied!", false);
    }
};

$bot.command(
    "echo", "Repeats some text",
    {"text": "Text"},
    func(interaction) {
        interaction.reply(interaction.options.text, false);
    }
);

$bot.run(fs.read("examples/discord/token.txt"));
