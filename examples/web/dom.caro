use gui;
use dom;

$window = gui.Window("DOM test");

func shown() {
    span1 = dom.Node("span");
    span1.text = "Node added and text set from Carotene";
    dom.id("caro-container").add(span1);
}

$other_spans_added = 0;
func add_node() {

    if($other_spans_added == 0) {
        $other_spans_added = 1;

        span2 = dom.Node("span", "Here's another span.. but with CSS on it and <b>HTML tags inside it</b>!");
        span2.css = {"color": "#ffaaaa"};
        dom.id("caro-container").add(span2);

    } elif($other_spans_added == 1) {
        $other_spans_added = 2;

        dom.body.css = {"padding": "2em"};

        div = dom.Node("div", "And here's a div, but unlike the spans, it's outside the GUI box, has an ID and a class, and has a list inside it.");
        div.id = "outside-div";
        div.classes = ["outside"];
        dom.body.add(div);

        ul = dom.Node("ul");
        ul.children = [
            dom.Node("li", "Item 1"), dom.Node("li", "Item 2")
        ];
        div.add(ul);

    }

}

$window.add(gui.Button("Add another span!", add_node), 0, 0);

$window.show(shown);
