
use math;
use random;
use http;

log("o", "The web build is working!");
log("i", "Very important log message!", true);

print("Hi from wasm!");
js("console.log('Hi from JS from wasm!')");

js("document.body.innerHTML += `<div style='padding: 4em'><p>This is the Carotene web example.</p><p>Check the DevTools console!</p></div>`;");

print("Let's solve a random quadratic equation to test things out.");

a = random.int(1, 10);
b = random.int(1, 10);
c = random.int(1, 10);

print(a, false);
print("x² - ", false);
print(b, false);
print("x + ", false);
print(c, false);
print(" = 0");

discriminant = (b ^ 2) - (4 * a * c);
if(discriminant > 0) {
    print(((-b) + math.sqrt(discriminant)) / (2 * a), false);
    print(", ", false);
    print(((-b) - math.sqrt(discriminant)) / (2 * a), false);
} else if(discriminant == 0) {
    print(((-b) + math.sqrt(discriminant)) / (2 * a), false);
} else {
    print("No real solution", false);
}
print("");

print(f"[b]Bold[] [i]Italic[] [b][i]Both[] [i]Inverse[] [#ff0000]R[#00ff00]G[#0000ff]B[] [#00ffff]C[#ff00ff]M[#ffff00]Y[#000000]K[] [1.5]Big[] [1]Normal[] [0.67]Small[]");

print("And finally, let's fetch this file's source code from Github.");
result = http.get("https://raw.githubusercontent.com/anpang54/carotene/refs/heads/main/examples/web/main.caro");
print(result);
