    Variable names are kept exactly the same
    Each Carotene line's C equivalent is left as a comment below it

*/

use raylib;    // has wrappers for both raylib.h and rcamera.h
use random;
// #include "raylib.h"
// #include "rcamera.h"

#MAX_COLUMNS = 20;
// #define MAX_COLUMNS 20

//------------------------------------------------------------------------------------
// Program main entry point
//------------------------------------------------------------------------------------
// int main(void)
// {
    // Initialization
    //--------------------------------------------------------------------------------------
    #screenWidth = 800;
    // const int screenWidth = 800;
    #screenHeight = 450;
    // const int screenHeight = 450;

    game = raylib.Game("raylib [core] example - 3d camera first person - Carotene port", #screenWidth, #screenHeight);
    game.show();
    // InitWindow(screenWidth, screenHeight, "raylib [core] example - 3d camera first person");

    // Define the camera to look into our 3d world (position, target, up vector)
    camera = raylib.Camera();
    // Camera camera = { 0 };
    camera.position = vec3f(0.0f, 2.0f, 4.0f);          // Camera position
    // camera.position = (Vector3){ 0.0f, 2.0f, 4.0f };    // Camera position
    camera.target = vec3f(0.0f, 2.0f, 0.0f);            // Camera looking at point
    // camera.target = (Vector3){ 0.0f, 2.0f, 0.0f };      // Camera looking at point
    camera.up = vec3f(0.0f, 1.0f, 0.0f);                // Camera up vector (rotation towards target)
    // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f };          // Camera up vector (rotation towards target)
    camera.fov = 60.0f;                                 // Camera field-of-view Y
    // camera.fovy = 60.0f;                                // Camera field-of-view Y
    camera.projection = "perspective";                  // Camera projection type
    // camera.projection = CAMERA_PERSPECTIVE;             // Camera projection type

    cameraMode = "first_person";
    // int cameraMode = CAMERA_FIRST_PERSON;

    // Generates some random columns
    heights = [];
    // float heights[MAX_COLUMNS] = { 0 };
    positions = [];
    // Vector3 positions[MAX_COLUMNS] = { 0 };
    colors = [];
    // Color colors[MAX_COLUMNS] = { 0 };

    repeat(#MAX_COLUMNS): i
    // for (int i = 0; i < MAX_COLUMNS; i++)
    {
        heights.append(float(random.int(1, 12)));
        // heights[i] = (float)GetRandomValue(1, 12);
        positions.append(vec3f(random.int(-15, 15), heights[i]/2.0f, random.int(-15, 15)));
        // positions[i] = (Vector3){ (float)GetRandomValue(-15, 15), heights[i]/2.0f, (float)GetRandomValue(-15, 15) };
        colors.append(color(random.int(20, 255), random.int(10, 55), 30, 255));
        // colors[i] = (Color){ GetRandomValue(20, 255), GetRandomValue(10, 55), 30, 255 };
    }

    game.lock_cursor = true;            // Limit cursor to relative movement inside the window
    // DisableCursor();                    // Limit cursor to relative movement inside the window

    // (Carotene recommends VSync instead)
    // SetTargetFPS(60);                   // Set our game to run at 60 frames-per-second
    //--------------------------------------------------------------------------------------

    // Main game loop
    while(game.running())               // Detect window close button or ESC key
    // while (!WindowShouldClose())        // Detect window close button or ESC key
    {
        // Update
        //----------------------------------------------------------------------------------
        // Switch camera mode
        if(game.key_pressed("1"))
        // if (IsKeyPressed(KEY_ONE))
        {
            cameraMode = "free";
            // cameraMode = CAMERA_FREE;
            camera.up = vec3f(0.0f, 1.0f, 0.0f); // Reset roll
            // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f }; // Reset roll
        }

        if(game.key_pressed("2"))
        // if (IsKeyPressed(KEY_TWO))
        {
            cameraMode = "first_person";
            // cameraMode = CAMERA_FIRST_PERSON;
            camera.up = vec3f(0.0f, 1.0f, 0.0f); // Reset roll
            // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f }; // Reset roll
        }

        if(game.key_pressed("3"))
        // if (IsKeyPressed(KEY_THREE))
        {
            cameraMode = "third_person";
            // cameraMode = CAMERA_THIRD_PERSON;
            camera.up = vec3f(0.0f, 1.0f, 0.0f); // Reset roll
            // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f }; // Reset roll
        }

        if(game.key_pressed("4"))
        // if (IsKeyPressed(KEY_FOUR))
        {
            cameraMode = "orbital";
            // cameraMode = CAMERA_ORBITAL;
            camera.up = vec3f(0.0f, 1.0f, 0.0f); // Reset roll
            // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f }; // Reset roll
        }

        // Switch camera projection
        if(game.key_pressed("p"))
        // if (IsKeyPressed(KEY_P))
        {
            if(camera.projection == "perspective")
            // if (camera.projection == CAMERA_PERSPECTIVE)
            {
                // Create isometric view
                cameraMode = "third_person";
                // cameraMode = CAMERA_THIRD_PERSON;
                // Note: The target distance is related to the render distance in the orthographic projection
                camera.position = vec3f(0.0f, 2.0f, -100.0f);
                // camera.position = (Vector3){ 0.0f, 2.0f, -100.0f };
                camera.target = vec3f(0.0f, 2.0f, 0.0f);
                // camera.target = (Vector3){ 0.0f, 2.0f, 0.0f };
                camera.up = vec3f(0.0f, 1.0f, 0.0f);
                // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f };
                camera.projection = "orthographic";
                // camera.projection = CAMERA_ORTHOGRAPHIC;
                camera.fov = 20.0f; // near plane width in CAMERA_ORTHOGRAPHIC
                // camera.fovy = 20.0f; // near plane width in CAMERA_ORTHOGRAPHIC
                camera.yaw(-135, true);
                // CameraYaw(&camera, -135*DEG2RAD, true);
                camera.pitch(-45, true, true, false);
                // CameraPitch(&camera, -45*DEG2RAD, true, true, false);
            }
            elif(camera.projection == "orthographic")
            // else if (camera.projection == CAMERA_ORTHOGRAPHIC)
            {
                // Reset to default view
                cameraMode = "third_person";
                // cameraMode = CAMERA_THIRD_PERSON;
                camera.position = vec3f(0.0f, 2.0f, 10.0f);
                // camera.position = (Vector3){ 0.0f, 2.0f, 10.0f };
                camera.target = vec3f(0.0f, 2.0f, 0.0f);
                // camera.target = (Vector3){ 0.0f, 2.0f, 0.0f };
                camera.up = vec3f(0.0f, 1.0f, 0.0f);
                // camera.up = (Vector3){ 0.0f, 1.0f, 0.0f };
                camera.projection = "perspective";
                // camera.projection = CAMERA_PERSPECTIVE;
                camera.fov = 60.0f;
                // camera.fovy = 60.0f;
            }
        }

        // Update camera computes movement internally depending on the camera mode
        // Some default standard keyboard/mouse inputs are hardcoded to simplify use
        // For advanced camera controls, it's recommended to compute camera movement manually
        camera.update(cameraMode);                          // Update camera
        // UpdateCamera(&camera, cameraMode);                  // Update camera

        //----------------------------------------------------------------------------------

        // Draw
        //----------------------------------------------------------------------------------
        game.begin();
        // BeginDrawing();

            game.background(raylib.ray_white);
            // ClearBackground(RAYWHITE);

            game.begin_3d(camera);
            // BeginMode3D(camera);

                game.plane(vec3f(0.0f, 0.0f, 0.0f), vec2f(32.0f, 32.0f), raylib.light_gray); // Draw ground
                // DrawPlane((Vector3){ 0.0f, 0.0f, 0.0f }, (Vector2){ 32.0f, 32.0f }, LIGHTGRAY); // Draw ground
                game.cube(vec3f(-16.0f, 2.5f, 0.0f), vec3f(1.0f, 5.0f, 32.0f), raylib.blue);     // Draw a blue wall
                // DrawCube((Vector3){ -16.0f, 2.5f, 0.0f }, 1.0f, 5.0f, 32.0f, BLUE);     // Draw a blue wall
                game.cube(vec3f(16.0f, 2.5f, 0.0f), vec3f(1.0f, 5.0f, 32.0f), raylib.lime);      // Draw a green wall
                // DrawCube((Vector3){ 16.0f, 2.5f, 0.0f }, 1.0f, 5.0f, 32.0f, LIME);      // Draw a green wall
                game.cube(vec3f(0.0f, 2.5f, 16.0f), vec3f(32.0f, 5.0f, 1.0f), raylib.gold);      // Draw a yellow wall
                // DrawCube((Vector3){ 0.0f, 2.5f, 16.0f }, 32.0f, 5.0f, 1.0f, GOLD);      // Draw a yellow wall

                // Draw some cubes around
                for(i = 0; i < #MAX_COLUMNS; i += 1)
                // for (int i = 0; i < MAX_COLUMNS; i++)
                {
                    game.cube(positions[i], vec3f(2.0f, heights[i], 2.0f), colors[i]);
                    // DrawCube(positions[i], 2.0f, heights[i], 2.0f, colors[i]);
                    game.cube_outline(positions[i], vec3f(2.0f, heights[i], 2.0f), raylib.maroon);
                    // DrawCubeWires(positions[i], 2.0f, heights[i], 2.0f, MAROON);
                }

                // Draw player cube
                if(cameraMode == "third_person")
                // if (cameraMode == CAMERA_THIRD_PERSON)
                {
                    game.cube(camera.target, vec3f(0.5f, 0.5f, 0.5f), raylib.purple);
                    // DrawCube(camera.target, 0.5f, 0.5f, 0.5f, PURPLE);
                    game.cube_outline(camera.target, vec3f(0.5f, 0.5f, 0.5f), raylib.dark_purple);
                    // DrawCubeWires(camera.target, 0.5f, 0.5f, 0.5f, DARKPURPLE);
                }

            game.end_3d();
            // EndMode3D();

            // Draw info boxes
            game.rectangle(vec2i(5, 5), vec2i(330, 100), color(raylib.sky_blue.x, raylib.sky_blue.y, raylib.sky_blue.z, 255*0.5f));
            // DrawRectangle(5, 5, 330, 100, Fade(SKYBLUE, 0.5f));
            game.rectangle_outline(vec2i(5, 5), vec2i(330, 100), raylib.blue);
            // DrawRectangleLines(5, 5, 330, 100, BLUE);

            game.text("Camera controls:", vec2i(15, 15), raylib.black, 10);
            // DrawText("Camera controls:", 15, 15, 10, BLACK);
            game.text("- Move keys: W, A, S, D, Space, Left-Ctrl", vec2i(15, 30), raylib.black, 10);
            // DrawText("- Move keys: W, A, S, D, Space, Left-Ctrl", 15, 30, 10, BLACK);
            game.text("- Look around: arrow keys or mouse", vec2i(15, 45), raylib.black, 10);
            // DrawText("- Look around: arrow keys or mouse", 15, 45, 10, BLACK);
            game.text("- Camera mode keys: 1, 2, 3, 4", vec2i(15, 60), raylib.black, 10);
            // DrawText("- Camera mode keys: 1, 2, 3, 4", 15, 60, 10, BLACK);
            game.text("- Zoom keys: num-plus, num-minus or mouse scroll", vec2i(15, 75), raylib.black, 10);
            // DrawText("- Zoom keys: num-plus, num-minus or mouse scroll", 15, 75, 10, BLACK);
            game.text("- Camera projection key: P", vec2i(15, 90), raylib.black, 10);
            // DrawText("- Camera projection key: P", 15, 90, 10, BLACK);

            game.rectangle(vec2i(600, 5), vec2i(195, 100), color(raylib.sky_blue.x, raylib.sky_blue.y, raylib.sky_blue.z, 255*0.5f));
            // DrawRectangle(600, 5, 195, 100, Fade(SKYBLUE, 0.5f));
            game.rectangle_outline(vec2i(600, 5), vec2i(195, 100), raylib.blue);
            // DrawRectangleLines(600, 5, 195, 100, BLUE);

            game.text("Camera status:", vec2i(610, 15), raylib.black, 10);
            // DrawText("Camera status:", 610, 15, 10, BLACK);
            game.text(f"- Mode: {(cameraMode == "free") ? "FREE" : (cameraMode == "first_person") ? "FIRST_PERSON" : (cameraMode == "third_person") ? "THIRD_PERSON" : (cameraMode == "orbital") ? "ORBITAL" : "CUSTOM"}", vec2i(610, 30), raylib.black, 10);
            // DrawText(TextFormat("- Mode: %s", (cameraMode == CAMERA_FREE) ? "FREE" :
            //                                   (cameraMode == CAMERA_FIRST_PERSON) ? "FIRST_PERSON" :
            //                                   (cameraMode == CAMERA_THIRD_PERSON) ? "THIRD_PERSON" :
            //                                   (cameraMode == CAMERA_ORBITAL) ? "ORBITAL" : "CUSTOM"), 610, 30, 10, BLACK);
            game.text(f"- Projection: {(camera.projection == "perspective") ? "PERSPECTIVE" : (camera.projection == "orthographic") ? "ORTHOGRAPHIC" : "CUSTOM"}", vec2i(610, 45), raylib.black, 10);
            // DrawText(TextFormat("- Projection: %s", (camera.projection == CAMERA_PERSPECTIVE) ? "PERSPECTIVE" :
            //                                         (camera.projection == CAMERA_ORTHOGRAPHIC) ? "ORTHOGRAPHIC" : "CUSTOM"), 610, 45, 10, BLACK);
            game.text(f"- Position: ({camera.position.x}, {camera.position.y}, {camera.position.z})", vec2i(610, 60), raylib.black, 10);
            // DrawText(TextFormat("- Position: (%06.3f, %06.3f, %06.3f)", camera.position.x, camera.position.y, camera.position.z), 610, 60, 10, BLACK);
            game.text(f"- Target: ({camera.target.x}, {camera.target.y}, {camera.target.z})", vec2i(610, 75), raylib.black, 10);
            // DrawText(TextFormat("- Target: (%06.3f, %06.3f, %06.3f)", camera.target.x, camera.target.y, camera.target.z), 610, 75, 10, BLACK);
            game.text(f"- Up: ({camera.up.x}, {camera.up.y}, {camera.up.z})", vec2i(610, 90), raylib.black, 10);
            // DrawText(TextFormat("- Up: (%06.3f, %06.3f, %06.3f)", camera.up.x, camera.up.y, camera.up.z), 610, 90, 10, BLACK);

        game.end();
        // EndDrawing();
        //----------------------------------------------------------------------------------
    }

    // De-Initialization
    //--------------------------------------------------------------------------------------
    game.close();         // Close window and OpenGL context
    // CloseWindow();        // Close window and OpenGL context
    //--------------------------------------------------------------------------------------

    // return 0;
// }
