

// Graphs a vertical sine wave.


use math;

#length = 75;

lines = [" " * #length, " " * #length, " " * #length, "-" * #length, " " * #length, " " * #length, " " * #length];

func getSin(x) {
    return round((math.sin(x / 4d) + 1) * 3);
}
repeat(#length): x{
    y = getSin(x);
    if(getSin(x + 1) < y) {
        lines[y][x] = "/";
    } else if(getSin(x + 1) > y) {
        lines[y][x] = "\";
    } else {
        lines[y][x] = "-";
    }
}

print("");
repeat(7): line{
    print(lines[line]);
}