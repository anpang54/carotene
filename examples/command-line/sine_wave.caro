

// Graphs a vertical sine wave.


use math;

#length = 75;
#line_count = 7;

lines = [];
repeat(#line_count) {
    lines.append(" " * #length);
}

func getSin(x) {
    return round((math.sin(x / 4d) + 1) * 3);
}
repeat(#length): x{
    y = getSin(x);
    lines[y][x] = getSin(x + 1) < y? "/": (getSin(x + 1) > y? "\": "-");
}

print("");
repeat(#line_count): line{
    print(lines[line]);
}