

// Makes some calculations about a sphere using its radius.


#r = 6.7;
#pi = 3.141592653589793;

print("");
print(f"Radius:        {#r}");
print(f"Diameter:      {#r * 2}");
print(f"Circumference: {2 * #pi * #r}");
print(f"Surface area:  {4 * #pi * #r^2}");
print(f"Volume:        {(4/3) * #pi * #r^3}");

